# ── Mercado Pago ──────────────────────────────────────────────
# De todas las variables de este archivo, estas 2 son las ÚNICAS que
# cambian entre entorno de PRUEBAS (sandbox) y PRODUCCIÓN:
#   - MP_ACCESS_TOKEN
#   - MP_PUBLIC_KEY
# En pruebas, ambas empiezan con "TEST-". En producción, ambas empiezan
# con "APP_USR-". Deben pertenecer siempre a la MISMA aplicación/cuenta
# de Mercado Pago (no mezclar un TEST- con un APP_USR-, ni credenciales
# de aplicaciones distintas).
#
# Access Token: SECRETO. Solo backend. Nunca lo expongas al frontend ni lo subas al repo.
MP_ACCESS_TOKEN=your-mercadopago-access-token
# Public Key: pública, se puede exponer al frontend (vía GET /api/config).
MP_PUBLIC_KEY=your-mercadopago-public-key
# Secreto de firma del webhook (panel MP → Webhooks / Notificaciones).
# Si está vacío, el webhook sigue funcionando consultando el pago en la API.
# En producción conviene definirlo para rechazar notificaciones falsas.
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# ── App ───────────────────────────────────────────────────────
# Local: http://localhost:3000
# Producción: URL pública HTTPS de tu dominio (sin barra final)
BASE_URL=your-app-base-url
PORT=your-app-port
# En Hostinger / producción debe ser exactamente: production
NODE_ENV=production
# Acceso restringido previo al lanzamiento.
# true = el sitio pide SITE_PASSWORD para entrar (webhook y /api/health siguen públicos).
# false o ausente = sitio público (index.html en /).
COMING_SOON=false
# Contraseña para entrar mientras COMING_SOON=true. SECRETO. Solo backend.
# Defínela en Hostinger → Variables de entorno. No la subas al repo.
SITE_PASSWORD=your-preview-password
# Sección Pokémon TCG.
# false o ausente = oculta: no se venden productos Pokémon y sus páginas/JSON responden 404.
# true = habilitada (recuerda también POKEMON_HABILITADO en producto.js).
POKEMON_HABILITADO=false
# Contraseña del panel /admin.html. SECRETO. Distinta de SITE_PASSWORD.
# Sin esta variable el admin no inicia sesión.
ADMIN_PASSWORD=your-admin-password
# Datos del remitente en etiquetas de despacho (solo API admin autenticada).
ADMIN_REMITENTE_NOMBRE=your-sender-name
ADMIN_REMITENTE_RUT=your-sender-rut
ADMIN_REMITENTE_TELEFONO=your-sender-phone
ADMIN_REMITENTE_EMAIL=your-sender-email

# ── Firebase Admin (service account) ──────────────────────────
# Local: ruta al archivo JSON de la service account (preferido en desarrollo).
# Relativa al root del proyecto o absoluta. No subas este archivo al repo.
FIREBASE_SERVICE_ACCOUNT_PATH=your-service-account-json-path
# Hostinger / prod: JSON completo en UNA sola línea (si no usas PATH).
# Nunca subas el archivo .json al repositorio.
FIREBASE_SERVICE_ACCOUNT=your-service-account-json-inline
# Publica firestore.rules en Firebase Console (Firestore → Rules):
# allow read, write: if false;  ← el servidor usa Admin SDK y no necesita reglas abiertas.

# ── Correo (formulario de contacto) ───────────────────────────
# SMTP del buzón contacto@anime2chile.cl (panel Hostinger → Emails).
# SECRETO. Solo backend. Nunca lo expongas al frontend ni lo subas al repo.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@anime2chile.cl
SMTP_PASS=your-mailbox-password
# Destinatario de los mensajes del formulario (normalmente el mismo buzón).
CONTACT_TO=contacto@anime2chile.cl
# Avisos de venta aprobada (comprador recibe el suyo aparte).
# Varios destinos: ventas@anime2chile.cl,otro@anime2chile.cl
# Si no se define, se usa ventas@anime2chile.cl.
ORDERS_TO=ventas@anime2chile.cl
