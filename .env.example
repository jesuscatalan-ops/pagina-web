# ── Mercado Pago ──────────────────────────────────────────────
# De todas las variables de este archivo, estas 2 son las ÚNICAS que
# cambian entre entorno de PRUEBAS (sandbox) y PRODUCCIÓN:
#   - MP_ACCESS_TOKEN
#   - MP_PUBLIC_KEY
# En pruebas, ambas empiezan con "TEST-". En producción, ambas empiezan
# con "APP_USR-". Deben pertenecer siempre a la MISMA aplicación/cuenta
# de Mercado Pago (no mezclar un TEST- con un APP_USR-, ni credenciales
# de aplicaciones distintas).
#
# Access Token: SECRETO. Solo backend. Nunca lo expongas al frontend ni lo subas al repo.
MP_ACCESS_TOKEN=your-mercadopago-access-token
# Public Key: pública, se puede exponer al frontend (vía GET /api/config).
MP_PUBLIC_KEY=your-mercadopago-public-key

# ── App ───────────────────────────────────────────────────────
# Local: http://localhost:3000
# Producción: URL pública HTTPS de tu dominio (sin barra final)
BASE_URL=your-app-base-url
PORT=your-app-port

# ── Firebase Admin (service account) ──────────────────────────
# Local: ruta al archivo JSON de la service account (preferido en desarrollo).
# Relativa al root del proyecto o absoluta. No subas este archivo al repo.
FIREBASE_SERVICE_ACCOUNT_PATH=your-service-account-json-path
# Hostinger / prod: JSON completo en UNA sola línea (si no usas PATH).
# Nunca subas el archivo .json al repositorio.
FIREBASE_SERVICE_ACCOUNT=your-service-account-json-inline
